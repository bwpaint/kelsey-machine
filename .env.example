# ─── KMS environment variables ────────────────────────────────────────────────
# Copy to .env for local dev, and set these in the Vercel dashboard for prod.

# Resend (lead form email delivery) — required for the contact forms to send.
# Get the API key at https://resend.com and verify the sending domain first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=service@kmstx.com
LEAD_FROM_EMAIL=leads@kmstx.com

# Optional: override the lead endpoint. Leave unset to use the built-in
# Vercel function at /api/submit. When the headless WordPress CMS is live,
# set this to the WP endpoint and the forms switch over with no code change:
# VITE_LEAD_ENDPOINT=https://cms.kmstx.com/wp-json/wwcf/v1/submit

# Google Tag Manager container ID (see index.html). Replace the placeholder
# GTM-XXXXXXX in index.html with your real container when ready.
