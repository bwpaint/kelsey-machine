# ─── KMS environment variables ────────────────────────────────────────────────
# Copy to .env for local dev, and set these in the Vercel dashboard for prod.

# ─── Production transport: WebWize Connect Forms (WordPress) ──────────────────
# When BOTH of these are set, /api/submit forwards to WP. Until then, Resend
# (below) is the fallback so forms never silently fail.
WP_BASE_URL=https://cms.kmstx.com
WP_FORMS_API_KEY=copy_from_WebWize_Connect_Forms_admin_page

# ─── Fallback transport: Resend (only used until WP is live) ──────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=service@kmstx.com
LEAD_FROM_EMAIL=leads@kmstx.com
# (Once WP_BASE_URL + WP_FORMS_API_KEY are set in Vercel, the Resend keys
#  become unused — safe to delete from the Vercel dashboard.)

# ─── Optional: override the lead endpoint entirely ────────────────────────────
# Leave unset to use the built-in Vercel function at /api/submit (recommended —
# the function is the auth proxy that keeps WP_FORMS_API_KEY out of the browser).
# VITE_LEAD_ENDPOINT=

# ─── Google Tag Manager ───────────────────────────────────────────────────────
# Replace the GTM-XXXXXXX placeholder in client/index.html with your real
# container ID and uncomment the two snippets there to activate.
