{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd astro && pnpm install && pnpm build",
  "outputDirectory": "astro/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/pump-service", "destination": "/services/pump-service", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}
