---
/**
 * Service page template — renders a service's data file into a full page.
 * Usage: each /services/<slug>.astro page imports its data file and a
 * resolved seo object, then <ServicePage data={data} seo={seo}>.
 *
 * The template is heavy on real body content (not just SEO meta) so crawlers
 * see equipment types, failure modes, repair process, brands, and FAQs as
 * static HTML — the whole point of the Astro migration.
 */
import KmsLayout from "@/layouts/KmsLayout.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import HeroSlider from "@/components/HeroSlider.astro";
import { C, KMS_PHONE, KMS_PHONE_HREF } from "@/lib/brand";
import type { PageMeta } from "@/lib/rm";

export interface Props {
  data: any; // ServiceData — keeping wide so any service file works
  seo:  PageMeta;
}

const { data, seo } = Astro.props;

// Optional "Our Work" photo slider in the hero right column (only on pages
// that supply data.hero.slider). Pages without photos render the hero as before.
const heroSlides = data.hero.slider ?? [];
const hasSlider  = heroSlides.length > 0;

// JSON-LD: Service schema + FAQPage schema + Breadcrumbs — all baked in HTML
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://www.kmstx.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.kmstx.com/services" },
    { "@type": "ListItem", "position": 3, "name": data.hero.h1.split(" — ")[0], "item": `https://www.kmstx.com${data.url}` },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faqs.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---
<KmsLayout seo={seo}>

  {/* Page-level JSON-LD: Service + Breadcrumb + FAQPage */}
  <script type="application/ld+json" set:html={JSON.stringify(data.schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  {/* ───── Hero ───── */}
  <section
    class="service-page-hero"
    style={`background:linear-gradient(135deg, rgba(10,25,45,0.92) 0%, rgba(30,80,128,0.75) 100%);padding:4rem 0 3rem;border-bottom:3px solid ${C.green}`}
    aria-label="Page hero"
  >
    <div class="max-w-7xl mx-auto px-4">
      {/* Breadcrumbs */}
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex gap-2 list-none p-0 m-0 text-xs">
          <li><a href="/" class="text-kms-green no-underline" style="font-family:'Barlow',sans-serif">Home</a></li>
          <li class="text-white/40">/</li>
          <li><a href="/services" class="text-kms-green no-underline" style="font-family:'Barlow',sans-serif">Services</a></li>
          <li class="text-white/40">/</li>
          <li class="text-white/80" style="font-family:'Barlow',sans-serif">{data.hero.h1.split(" — ")[0]}</li>
        </ol>
      </nav>

      <div class={hasSlider ? "grid grid-cols-1 lg:grid-cols-5 gap-10 items-center" : ""}>
        <div class={hasSlider ? "lg:col-span-3" : ""}>
          <h1 class="text-white" style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem, 4vw, 3.2rem);line-height:1.1;letter-spacing:0.01em;text-transform:uppercase">
            {data.hero.h1}
          </h1>
          <p class="text-white/85 mt-4" style="font-family:'Source Sans 3',sans-serif;font-size:1.1rem;line-height:1.6;max-width:60ch">
            {data.hero.subheading}
          </p>
          <div class="flex gap-3 mt-6">
            <a href="#quote" class="text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:700;padding:0.65rem 1.5rem;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase`}>Get Free Quote</a>
            <a href={KMS_PHONE_HREF} class="text-white no-underline border-2 border-white/40 hover:border-kms-green" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;padding:0.55rem 1.5rem;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase">Call {KMS_PHONE}</a>
          </div>
        </div>
        {hasSlider && (
          <div class="lg:col-span-2">
            <HeroSlider slides={heroSlides} label={data.hero.sliderLabel ?? "Our Work"} />
          </div>
        )}
      </div>
    </div>
  </section>

  {/* ───── Main content ───── */}
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-3 gap-12">

      {/* Main column */}
      <article class="lg:col-span-2">
        {data.intro.map((p: string) => (
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:1.05rem;color:${C.textDark};line-height:1.8;margin-bottom:1.25rem`}>
            {p}
          </p>
        ))}

        {/* Quick Answer box */}
        <aside style={`background:${C.lightBg};border-left:4px solid ${C.green};padding:1.25rem 1.5rem;margin:1.5rem 0;border-radius:0 4px 4px 0`}>
          <div style={`font-family:'Barlow',sans-serif;font-weight:700;font-size:0.75rem;color:${C.green};letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem`}>Quick Answer</div>
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:1rem;color:${C.textDark};line-height:1.7;margin:0`}>{data.quickAnswer}</p>
        </aside>

        {/* Equipment types */}
        <h2 class="mt-10 mb-4 uppercase" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:${C.blueDark};letter-spacing:-0.01em`}>
          Types of Equipment We Repair
        </h2>
        <div class="flex flex-col gap-5 mb-8">
          {data.equipmentTypes.map((t: any) => (
            <div style={`border-left:4px solid ${C.green};padding-left:1.25rem`}>
              <h3 style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.2rem;color:${C.blueDark};margin-bottom:0.4rem;text-transform:uppercase;letter-spacing:0.02em`}>{t.name}</h3>
              <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.97rem;color:${C.textMid};line-height:1.7;margin:0`}>{t.desc}</p>
            </div>
          ))}
        </div>

        {/* Failure modes */}
        <h2 class="mt-10 mb-4 uppercase" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:${C.blueDark};letter-spacing:-0.01em`}>
          Common Failure Modes We See
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          {data.failureModes.map((f: any) => (
            <div style={`background:${C.lightBg};padding:1.25rem;border-radius:4px`}>
              <h3 style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;color:${C.blueDark};margin-bottom:0.4rem;text-transform:uppercase;letter-spacing:0.02em`}>{f.title}</h3>
              <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.92rem;color:${C.textMid};line-height:1.6;margin:0`}>{f.desc}</p>
            </div>
          ))}
        </div>

        {/* Repair process */}
        <h2 class="mt-10 mb-4 uppercase" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:${C.blueDark};letter-spacing:-0.01em`}>
          Our Repair Process
        </h2>
        <ol class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none p-0 mb-8">
          {data.process.map((s: any) => (
            <li style={`background:white;border:1px solid #e5e7eb;border-radius:4px;padding:1rem 1.25rem`}>
              <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.5rem;color:${C.green};line-height:1`}>{s.step}</div>
              <h3 style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1rem;color:${C.blueDark};margin:0.4rem 0;text-transform:uppercase;letter-spacing:0.02em`}>{s.title}</h3>
              <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.6;margin:0`}>{s.desc}</p>
            </li>
          ))}
        </ol>

        {/* Brands */}
        <h2 class="mt-10 mb-4 uppercase" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:${C.blueDark};letter-spacing:-0.01em`}>
          Brands We Service
        </h2>
        <div class="flex flex-wrap gap-x-5 gap-y-2 mb-10" style={`font-family:'Source Sans 3',sans-serif;font-size:0.95rem;color:${C.textMid}`}>
          {data.brands.map((b: string) => <span>{b}</span>)}
        </div>

        {/* FAQs (FAQPage schema is in JSON-LD above) */}
        <h2 class="mt-10 mb-4 uppercase" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem,3vw,2rem);color:${C.blueDark};letter-spacing:-0.01em`}>
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {data.faqs.map((f: any) => (
            <details class="bg-white border border-gray-200 rounded-sm group">
              <summary class="cursor-pointer p-4 list-none flex justify-between items-center" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;color:#1A2535">
                <span>{f.q}</span>
                <span class="text-kms-green group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <div class="px-4 pb-4 text-kms-textMid leading-relaxed" style="font-family:'Source Sans 3',sans-serif;font-size:0.95rem">{f.a}</div>
            </details>
          ))}
        </div>
      </article>

      {/* Sidebar — quote form + callouts */}
      <aside class="lg:sticky lg:top-32 h-fit space-y-6">
        <div id="quote" style={`background:linear-gradient(135deg, ${C.darkBg} 0%, ${C.blueDark} 100%);border-radius:4px;padding:1.5rem`}>
          <QuoteForm client:visible variant="contact" />
        </div>

        {/* Warranty callout */}
        <div style={`background:${C.lightBg};border:1px solid ${C.green}33;border-radius:4px;padding:1.25rem`}>
          <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.blueDark};text-transform:uppercase;letter-spacing:0.02em;margin-bottom:0.4rem`}>24-Month Warranty</div>
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.6;margin:0 0 0.75rem`}>The longest written warranty in the rotating equipment repair industry. Every rebuild, every time.</p>
          <a href="/warranty" class="text-kms-green no-underline text-sm uppercase tracking-wider" style="font-family:'Barlow',sans-serif;font-weight:700">Learn more →</a>
        </div>

        {/* Free Pickup callout */}
        <div style={`background:${C.lightBg};border:1px solid ${C.green}33;border-radius:4px;padding:1.25rem`}>
          <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.blueDark};text-transform:uppercase;letter-spacing:0.02em;margin-bottom:0.4rem`}>Free Nationwide Pickup</div>
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.6;margin:0`}>We coordinate inbound freight from anywhere in the U.S., Canada, or Mexico — no extra charge.</p>
        </div>

        {/* Emergency callout */}
        <div style={`background:${C.darkBg};border-radius:4px;padding:1.25rem;color:white`}>
          <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.green};text-transform:uppercase;letter-spacing:0.02em;margin-bottom:0.4rem`}>Equipment Down?</div>
          <p style="font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:rgba(255,255,255,0.7);line-height:1.6;margin:0 0 0.75rem">24/7 emergency response. We answer the phone day or night.</p>
          <a href={KMS_PHONE_HREF} class="block text-center text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:0.95rem;padding:0.65rem;border-radius:2px;letter-spacing:0.06em`}>
            Call {KMS_PHONE}
          </a>
        </div>
      </aside>

    </div>
  </div>

</KmsLayout>

<style is:inline define:vars={{ heroBg: `url(${data.hero.bgImage})` }}>
  /* Hero bg image is desktop-only — saves mobile from downloading a big LCP-blocking image. */
  @media (min-width: 768px) {
    .service-page-hero {
      background-image: linear-gradient(135deg, rgba(10,25,45,0.92) 0%, rgba(30,80,128,0.75) 100%), var(--heroBg) !important;
      background-position: center !important;
      background-size: cover !important;
      background-repeat: no-repeat !important;
    }
  }
</style>
