---
/**
 * PPC Landing Page layout — paid-search destination template.
 *
 * noindex,nofollow is enforced via the seo prop (passed in by each /lp/*
 * route's getMeta() with noindex: true), so these pages don't compete
 * with the canonical /services/* pages for organic traffic.
 *
 * Single shared template — each /lp/* route file just supplies its
 * data block (h1, subheading, bullets, row2, row3, service).
 */
import KmsLayout from "@/layouts/KmsLayout.astro";
import LpQuoteForm from "@/components/LpQuoteForm.tsx";
import LpTestimonialsCarousel from "@/components/LpTestimonialsCarousel.tsx";
import Icon from "@/components/Icons.astro";
import { C, KMS_PHONE, KMS_PHONE_HREF } from "@/lib/brand";
import { LP_TESTIMONIALS } from "@/lib/lp-data";
import type { PageMeta } from "@/lib/rm";

export interface Props {
  seo: PageMeta;
  h1: string;
  subheading: string;
  service: string;
  bullets: string[];
  row2: { headline: string; body: string; items: string[] };
  row3: { headline: string; body: string };
}

const { seo, h1, subheading, service, bullets, row2, row3 } = Astro.props;

// LP_TESTIMONIALS (lp-data.ts) now holds 5 real, sourced Google reviews
// (pulled 2026-08-11) — safe to render.
const TESTIMONIALS_READY = true;

// h1 is authored in lp-data.ts as "<Equipment> Down? We're Ready Right
// Now." — split AFTER the "?" (lookbehind keeps the "?" attached to the
// first clause: "Blower Down?", not "Blower Down") so the first clause
// can render much larger than the second. If a future h1 doesn't contain
// "?", h1Small comes back empty and the whole string just renders as the
// one big line — not a crash, just loses the two-size treatment.
const h1Parts = h1.split(/(?<=\?)\s*/);
const h1Big = h1Parts[0];
const h1Small = h1Parts[1] || "";

// Font-size for the big headline is computed per-page from h1Big's actual
// character count, not a flat clamp() — a fixed vw-based size that works
// for "Rig Down?" (9 chars) will either be too small for "Compressor
// Down?" (16 chars) or wrap it. 0.58 is an approximate average glyph
// advance width (as a fraction of font-size) for Barlow Condensed at 900
// weight, uppercase — deliberately a little conservative (slightly
// underfills rather than risking overflow/wrap if the estimate is off).
// container-type:inline-size on the wrapping column (below) makes `cqw`
// relative to that column's actual rendered width, not the viewport, so
// this sizes correctly whether the column is half the screen (desktop
// 2-col) or the full width (mobile, stacked).
const H1_BIG_CHAR_WIDTH = 0.58;
const h1BigFontSize = `clamp(2.2rem, calc(100cqw / ${(h1Big.length * H1_BIG_CHAR_WIDTH).toFixed(2)}), 7.5rem)`;
---
<KmsLayout seo={seo} headerVariant="minimal" footerVariant="minimal">

  {/*
    Yellowtail (script font for the "Value" flourish in the $250 badge
    below) loaded via Google Fonts here rather than self-hosted via
    @fontsource like the rest of the site's fonts — @fontsource requires
    adding a package to package.json, which needs pnpm-lock.yaml
    regenerated to match or Vercel's frozen-lockfile CI install fails
    (hit this directly: 2026-08-11 deploy broke on ERR_PNPM_OUTDATED_LOCKFILE).
    A plain <link> needs no lockfile at all. Small one-time perf trade-off
    (one extra font request) for one decorative word on 5 pages, in
    exchange for a change that can't break the build. Scoped to this LP
    layout only via slot="head", not the global KmsLayout.
  */}
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Yellowtail&display=swap" rel="stylesheet" />
  </Fragment>

  {/* HERO */}
  <section style={`background:linear-gradient(135deg, ${C.darkBg} 0%, ${C.blueDark} 100%);padding:4rem 0 3rem;min-height:85vh;display:flex;align-items:center`}>
    <div class="max-w-7xl mx-auto px-4 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        {/* Left — headline + copy + incentive badge + bullets + Call + trust badges.
            container-type:inline-size makes the h1BigFontSize `cqw` calc
            (above) relative to THIS column's rendered width. */}
        <div style="container-type:inline-size">
          {/*
            Two-size headline: first clause ("Blower Down?", "?" kept
            attached) sized via h1BigFontSize — a per-page calc() based on
            character count, not a flat clamp(), so it always fills the
            column width without wrapping regardless of how long the
            equipment name is. white-space:nowrap is a safety net in case
            the character-width estimate runs a little hot. Second clause
            ("We're Ready Right Now.") stays at the original fixed size.
          */}
          <h1 style="margin-bottom:1.25rem">
            <span style={`display:block;white-space:nowrap;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:${h1BigFontSize};color:white;text-transform:uppercase;letter-spacing:-0.02em;line-height:0.95`}>{h1Big}</span>
            {h1Small && (
              <span style="display:block;font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.2rem, 5vw, 3.5rem);color:white;text-transform:uppercase;letter-spacing:-0.02em;line-height:1.05;margin-top:0.2rem">{h1Small}</span>
            )}
          </h1>

          <p style="font-family:'Source Sans 3',sans-serif;font-size:1.1rem;color:rgba(255,255,255,0.75);line-height:1.7;margin-bottom:1.5rem">
            {subheading}
          </p>

          {/*
            $250/Value/Free incentive badge — sits below the subheading now
            (moved back per request). `lp-incentive-shake` (see <style>
            below) periodically shakes the whole badge, settles, and shakes
            again on a loop — respects prefers-reduced-motion.
          */}
          <div class="lp-incentive-shake" style={`background:rgba(120,165,70,0.14);border:1px solid ${C.green};border-radius:4px;padding:1.5rem 1.75rem;margin-bottom:1.5rem`}>
            <div style="text-align:center;line-height:1;margin-bottom:0.75rem">
              <span style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2.6rem, 7vw, 3.8rem);color:rgba(255,255,255,0.55);text-decoration:line-through;text-decoration-thickness:3px">$250</span>
              <span style="font-family:'Yellowtail',cursive;font-weight:400;font-size:clamp(1.5rem, 4vw, 2.3rem);letter-spacing:0;text-transform:none;color:rgba(255,255,255,0.65);margin:0 0.4rem">Value</span>
              <span style={`font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.2rem, 6vw, 3.1rem);letter-spacing:0.02em;text-transform:uppercase;color:${C.green}`}>Free!</span>
            </div>
            <p style="font-family:'Source Sans 3',sans-serif;font-weight:700;font-size:2.1rem;color:white;line-height:1.25;margin:0;text-align:center">
              Written failure analysis with root cause identification — FREE.
            </p>
            <p style="font-family:'Source Sans 3',sans-serif;font-size:1.6rem;color:rgba(255,255,255,0.5);line-height:1.3;margin:0.4rem 0 0;text-align:center">
              Our competition charges $250+ for this service.
            </p>
          </div>

          {/* Bullets trimmed to just equipment types + brands (lp-data.ts) —
              free pickup / warranty / 24-7 emergency are covered by the
              trust-badge tiles below, so listing them twice was redundant.
              Checkmark icons removed and lines centered per request —
              reads cleaner as plain centered text under the badge. */}
          <ul class="list-none p-0 m-0 flex flex-col gap-2.5 mb-8 text-center">
            {bullets.map((b) => (
              <li>
                <span style="font-family:'Source Sans 3',sans-serif;font-size:0.97rem;color:rgba(255,255,255,0.85)">{b}</span>
              </li>
            ))}
          </ul>

          {/* Single Call CTA — "Get Free Quote" and "24/7 Emergency" buttons
              removed from here (24/7 is already a trust-badge tile below;
              "Get Free Quote" is still reachable via the sticky mobile bar
              and ROW 3 below). tel: link, so it's tap-to-call on mobile. */}
          <div class="mb-8 flex justify-center">
            <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;letter-spacing:0.06em;text-transform:uppercase;padding:0.9rem 2rem;border-radius:2px`}>
              <Icon name="phone" size={18} /> Call {KMS_PHONE}
            </a>
          </div>

          {/* Trust badges */}
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {[
              { icon: "shield",       label: "24-Month Warranty", sub: "Written, not verbal" },
              { icon: "truck",        label: "Free Pickup",       sub: "All 50 states" },
              { icon: "clock",        label: "24/7 Emergency",    sub: "365 days a year" },
              { icon: "check-circle", label: "40+ Years",         sub: "In business" },
            ].map((tb) => (
              <div class="text-center" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:4px;padding:1rem">
                <div style={`color:${C.green};display:flex;justify-content:center;margin-bottom:0.4rem`}><Icon name={tb.icon as any} size={22} /></div>
                <div style="font-family:'Barlow',sans-serif;font-weight:700;font-size:0.88rem;color:white;line-height:1.2">{tb.label}</div>
                <div style="font-family:'Source Sans 3',sans-serif;font-size:0.78rem;color:rgba(255,255,255,0.5);margin-top:0.2rem">{tb.sub}</div>
              </div>
            ))}
          </div>
        </div>

        {/* Right — message-match banner + focused quote form */}
        <div>
          {/*
            Message-match reinforcement (a la Groas): when a visitor arrives
            via a Google Ads click carrying a keyword ValueTrack param, show
            the phrase they searched for right above the form. Reinforces
            "you're on the right page" at the exact moment of the CTA.

            Hidden by default (server-rendered with no client). The inline
            script below reveals it ONLY when a keyword param is present, so
            organic/direct visitors — who have no keyword param — never see
            a blank or broken box. Runs as a plain inline script (not a React
            island) so it paints synchronously with the rest of the hero,
            with zero hydration delay and zero layout shift.

            Google's {keyword} ValueTrack value is the KEYWORD YOU BID ON,
            not the visitor's literal search query — and it can carry
            match-type punctuation ([exact], "phrase", +broad+modifier) which
            gets stripped/cleaned client-side before display. This reads the
            same alias priority as astro/src/lib/adTracking.ts
            (keyword, utm_term, adkeyword, ad_keyword) — keep both in sync if
            that list ever changes.
          */}
          <div id="kw-match" hidden class="kw-match">
            <div class="kw-match__top">
              <span class="kw-match__check"><Icon name="check-circle" size={26} /></span>
              <span class="kw-match__label">Searching For:</span>
            </div>
            <div class="kw-match__phrase-wrap">
              <span id="kw-phrase" class="kw-match__phrase"></span><span class="kw-cursor" aria-hidden="true">|</span>
            </div>
            <div class="kw-match__confirm">You're In The Right Place!</div>
          </div>

          <div id="quote" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:2rem">
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.8rem, 4vw, 2.8rem);color:white;text-transform:uppercase;line-height:1.05;margin-bottom:0.5rem;text-align:center">Get Your Free Quote</div>
            {/* Three separate lines instead of one flowing sentence, sized
                to 2/3 of the previous 1.8rem (was doubled last round; this
                dials it back down while keeping the 3-line split). Centered
                per request, along with the heading above. */}
            <div style="font-family:'Source Sans 3',sans-serif;font-size:1.2rem;line-height:1.4;color:rgba(255,255,255,0.75);margin-bottom:1.5rem;font-weight:600;text-align:center">
              <div>We call you back within 30 minutes.</div>
              <div>Speak to a specialist right now.</div>
              <div>Call us at <a href={KMS_PHONE_HREF} style={`color:${C.green};font-weight:800;text-decoration:none`}>{KMS_PHONE}</a>.</div>
            </div>
            <LpQuoteForm client:idle service={service} />
          </div>
        </div>

      </div>
    </div>
  </section>

  {/*
    Testimonials — full-width row of its own, between the hero (form)
    section and ROW 2 ("what's included"). Light background, dark text —
    the earlier version used a dark-green section with white text; on
    white/light this flips to standard dark-on-light so contrast is a
    non-issue (no special-casing needed, unlike white-on-green which
    failed WCAG AA at body-copy size). Carousel shows 3 at a time on
    desktop (1 on mobile), slides one step at a time on a loop, pauses +
    shows arrows on hover — see LpTestimonialsCarousel.tsx for the
    implementation. Container widened to max-w-7xl to match the hero/
    ROW 2 content width (was max-w-5xl, too narrow now that 3 cards sit
    side by side).
  */}
  {TESTIMONIALS_READY && (
    <section class="bg-white" style="padding:3.5rem 0">
      <div class="max-w-7xl mx-auto px-4">
        <div style={`text-align:center;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem, 3vw, 2.1rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:-0.01em;margin-bottom:2rem`}>
          What Customers Say
        </div>
        <LpTestimonialsCarousel client:visible testimonials={LP_TESTIMONIALS} />
      </div>
    </section>
  )}

  {/*
    Scoped to this component only (not slotted content, so Astro's normal
    style scoping applies correctly here — see ContentPage.astro for why
    that distinction matters).

    --kw-label sets the small-text size; the big phrase is defined as
    calc(--kw-label * 3), so the "3x" ratio holds exactly at every
    breakpoint by construction rather than by two separately-tuned clamps
    drifting apart. At the width where the 2-column grid is active (lg+,
    1024px+), --kw-label lands at 0.85rem -> phrase 2.55rem, which is ~73%
    of the H1's max size (3.5rem) — close to the requested 75%. A single
    static ratio can't hit exactly 75% of a fluid clamp() at every viewport
    simultaneously as 3x a label size; this is the closest consistent
    compromise. Adjust --kw-label directly if the balance needs tuning.
  */}
  <style>
    .kw-match {
      --kw-label: 0.72rem;
      background: rgba(120,165,70,0.14);
      border: 1px solid #78A546;
      border-radius: 6px;
      padding: 1.1rem 1.25rem 1.3rem;
      margin-bottom: 1rem;
      text-align: center;
    }
    @media (min-width: 1024px) {
      /* Matches the lg: breakpoint where the hero grid goes 2-column
         (grid-cols-1 lg:grid-cols-2 below) — the only width where this
         box sits directly beside the H1 for a visible size comparison. */
      .kw-match { --kw-label: 0.85rem; }
    }
    .kw-match__top {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 0.3rem;
    }
    .kw-match__check {
      color: #78A546;
      display: inline-flex;
      flex-shrink: 0;
    }
    .kw-match__label {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: var(--kw-label);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.8);
    }
    .kw-match__phrase-wrap {
      line-height: 1.1;
      margin: 0.2rem 0 0.55rem;
      word-break: break-word;
    }
    .kw-match__phrase {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: calc(var(--kw-label) * 3);
      color: #78A546;
      text-transform: uppercase;
      letter-spacing: -0.01em;
    }
    /*
      "You're In The Right Place!" — bumped to 2.2x the base label size
      (was riding the same 1x size as "Searching For:", which buried the
      payoff line under the giant keyword phrase above it). 2.2x keeps it
      clearly the second-most-prominent element in the box, still smaller
      than the 3x keyword phrase so the hierarchy reads correctly.
    */
    .kw-match__confirm {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: calc(var(--kw-label) * 2.2);
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.95);
      line-height: 1.15;
      margin-top: 0.15rem;
    }
    .kw-cursor {
      display: inline-block;
      font-weight: 400;
      font-size: calc(var(--kw-label) * 3);
      color: #78A546;
      margin-left: 2px;
      animation: kwBlink 0.9s steps(1) infinite;
    }
    @keyframes kwBlink { 50% { opacity: 0; } }

    /*
      $250 incentive badge — shake, settle, shake again, forever. The
      wiggle itself only occupies the first ~12% of a 3.5s cycle; the
      remaining ~88% holds still at 0, which is what reads as "shakes,
      settles down, shakes again" rather than a continuous jitter.
    */
    .lp-incentive-shake {
      animation: incentiveShake 3.5s ease-in-out infinite;
    }
    @keyframes incentiveShake {
      0%, 12%, 100% { transform: translateX(0) rotate(0deg); }
      2%  { transform: translateX(-5px) rotate(-1.2deg); }
      4%  { transform: translateX(5px) rotate(1.2deg); }
      6%  { transform: translateX(-4px) rotate(-1deg); }
      8%  { transform: translateX(4px) rotate(1deg); }
      10% { transform: translateX(-2px) rotate(-0.5deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .kw-cursor { animation: none; }
      .lp-incentive-shake { animation: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      // Keep in sync with ALIASES.adKeyword in astro/src/lib/adTracking.ts
      var aliases = ["keyword", "utm_term", "adkeyword", "ad_keyword"];
      var raw = "";
      for (var i = 0; i < aliases.length; i++) {
        var v = params.get(aliases[i]);
        if (v) { raw = v; break; }
      }
      if (!raw) return;

      // Strip Google Ads match-type punctuation: [exact], "phrase". Broad
      // match's leading "+" is already converted to a literal space by
      // URLSearchParams during query-string parsing, so no separate handling
      // needed for that case.
      var clean = raw
        .replace(/^[\[\"]+|[\]\"]+$/g, "")
        .replace(/\+/g, " ")
        .trim()
        .replace(/\s+/g, " ");
      if (!clean) return;

      // Title Case, matching the site's existing headline/ad-copy convention.
      clean = clean.replace(/\w\S*/g, function (w) {
        return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
      });

      var phraseEl = document.getElementById("kw-phrase");
      var boxEl = document.getElementById("kw-match");
      if (!phraseEl || !boxEl) return;

      boxEl.hidden = false;

      // Typewriter reveal — keeps the eye on the box at the exact moment a
      // paid-search visitor lands, reinforcing "this page knows what you
      // searched for." Respects prefers-reduced-motion: users with that OS
      // preference get the full phrase instantly, no animation.
      var reduceMotion = window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduceMotion) {
        phraseEl.textContent = clean;
        return;
      }
      var i = 0;
      var speed = 38; // ms per character
      (function typeNext() {
        phraseEl.textContent = clean.slice(0, i);
        i++;
        if (i <= clean.length) setTimeout(typeNext, speed);
      })();
    })();
  </script>

  {/* ROW 2 — what's included + Why KMS panel */}
  <section class="bg-white" style="padding:4rem 0">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.5rem, 3vw, 2.2rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:-0.01em;margin-bottom:1rem`}>
            {row2.headline}
          </h2>
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:1rem;color:${C.textMid};line-height:1.75;margin-bottom:1.5rem`}>
            {row2.body}
          </p>
          <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
            {row2.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <span style={`color:${C.green};flex-shrink:0;margin-top:3px;display:inline-flex`}><Icon name="check-circle" size={16} /></span>
                <span style={`font-family:'Source Sans 3',sans-serif;font-size:0.95rem;color:${C.textDark};line-height:1.5`}>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div style={`background:${C.lightBg};border:2px solid ${C.green};border-radius:4px;padding:2.5rem`}>
          <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.blueDark};text-transform:uppercase;margin-bottom:1.25rem`}>Why KMS?</div>
          {[
            { label: "24-Month Written Warranty",         desc: "The industry standard is 90 days. We give you 24 months — in writing." },
            { label: "Free National Pickup",              desc: "We'll come get your equipment anywhere in the continental U.S." },
            { label: "24/7 Emergency Service",            desc: "Our emergency line is answered every day of the year. No exceptions." },
            { label: "All 50 States + Canada & Mexico",   desc: "Distance is not a barrier. We serve North America." },
          ].map((p) => (
            <div style="margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid #dde3ec">
              <div style={`font-family:'Barlow',sans-serif;font-weight:700;font-size:0.92rem;color:${C.blueDark};margin-bottom:0.2rem`}>{p.label}</div>
              <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.88rem;color:${C.textMid};line-height:1.5;margin:0`}>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ROW 3 — centered CTA */}
  <section style={`background:linear-gradient(135deg, ${C.blueDark} 0%, ${C.darkBg} 100%);padding:4rem 0`}>
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.75rem, 4vw, 2.75rem);color:white;text-transform:uppercase;letter-spacing:-0.02em;margin-bottom:1rem">
        {row3.headline}
      </h2>
      <p style="font-family:'Source Sans 3',sans-serif;font-size:1.05rem;color:rgba(255,255,255,0.7);line-height:1.75;margin:0 auto 2.5rem;max-width:680px">
        {row3.body}
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.15rem;letter-spacing:0.06em;text-transform:uppercase;padding:1rem 2.5rem;border-radius:2px`}>
          <Icon name="phone" size={20} /> Call {KMS_PHONE}
        </a>
        <a href="#quote" class="inline-flex items-center gap-2 text-white no-underline border-2 border-white/30" style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.15rem;letter-spacing:0.06em;text-transform:uppercase;padding:0.9rem 2.5rem;border-radius:2px">
          Get Free Quote
        </a>
      </div>
      <div style="margin-top:2rem;font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:rgba(255,255,255,0.45)">
