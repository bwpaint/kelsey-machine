---
/**
 * Site-wide layout.
 *
 * SEO comes from WebWize Connect RM (Route Meta) — each page calls
 * getMeta('/path', { ...defaults }) in its frontmatter and passes the
 * resolved PageMeta into the `seo` prop.
 *
 * Fonts are self-hosted via @fontsource so they bundle with the build and
 * ship from the same origin as everything else — no waiting on Google.
 * That removes ~750ms of render-blocking CSS + 7 separate font-file
 * round-trips that PageSpeed Insights flagged on mobile.
 *
 * Google tags (gtag.js):
 *   - AW-18043825480   Google Ads conversion tracking
 *   - G-FJZRMGRQCD     Google Analytics 4 measurement ID
 */
import Header from "@/components/Header.astro";
import MinimalHeader from "@/components/MinimalHeader.astro";
import Footer from "@/components/Footer.astro";
import MinimalFooter from "@/components/MinimalFooter.astro";
import type { PageMeta } from "@/lib/rm";
import { safeJsonLd } from "@/lib/jsonld";

// Self-hosted fonts — drop-in replacement for the Google Fonts <link>.
// Only the weights we actually use, to keep payload minimal.
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow/700.css";
import "@fontsource/barlow-condensed/400.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";

export interface Props {
  seo: PageMeta;
  // "minimal" = centered logo only, no nav links, no utility bar, no
  // competing CTA button — for PPC landing pages, where every nav link is
  // an exit from the single conversion path. Defaults to the full site
  // header everywhere else. See MinimalHeader.astro.
  headerVariant?: "full" | "minimal";
  // "minimal" = large logo only, no nav columns, no legal/social links —
  // pairs with headerVariant="minimal". See MinimalFooter.astro.
  footerVariant?: "full" | "minimal";
}

const { seo, headerVariant = "full", footerVariant = "full" } = Astro.props;
const canonical = seo.canonical || new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Google tag (gtag.js) — Google Ads + GA4 */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18043825480"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18043825480');
      gtag('config', 'G-FJZRMGRQCD');
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:title"       content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}

    {/* Twitter */}
    <meta name="twitter:card"        content={seo.twitterCard} />
    <meta name="twitter:title"       content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.ogDescription} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    {/* JSON-LD schema from RM, if present. Escaped via safeJsonLd — this
        string comes from the CMS, so a literal "</script>" inside it
        (in any field the schema was built from) would otherwise close
        this tag early and let the rest execute as HTML/JS. */}
    {seo.schemaJson && (
      <script type="application/ld+json" set:html={safeJsonLd(seo.schemaJson)} />
    )}

    <link rel="icon" href="/favicon.ico" />

    {/* Slot for page-specific head additions (preload images, extra schema, etc.) */}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-kms-textDark antialiased" style="font-family:'Source Sans 3',sans-serif">
    {headerVariant === "minimal" ? <MinimalHeader /> : <Header />}
    <main>
      <slot />
    </main>
    {footerVariant === "minimal" ? <MinimalFooter /> : <Footer />}
    <script>
      // Capture Google Ads click attribution (gclid + ValueTrack params) on
      // every page load, persisting it to localStorage so it survives the
      // visitor navigating between pages before submitting a form. Without
      // this, attribution only worked when the form lived on the landing
      // page itself. See src/lib/adTracking.ts.
      import { getAdTracking } from "@/lib/adTracking";
      getAdTracking();
    </script>
    <script>
      // Site-wide tel: click tracking (added 2026-08-12).
      //
      // Before this, every `tel:` link on the site (30+ of them, across
      // header, footer, LP pages, sticky mobile bar) fired nothing — phone
      // intent was completely invisible in both GA4 and Google Ads. For a
      // business where the buyer calls from the job site instead of filling
      // a form, that's not a rounding error, that's most of the funnel.
      //
      // Delegated to `document` (not attached per-link) so it covers every
      // tel: link on every page, including ones rendered by React islands
      // after hydration, without having to touch each component. Fires:
      //   1. A GA4 event ("phone_call_click") — mark this as a GA4 Key
      //      Event in Admin > Events once it starts reporting, or it just
      //      sits there uncounted the same way form_submit was.
      //   2. A Google Ads conversion under the new "Click to call" action
      //      (created 2026-08-12 in Goals > Conversions > Phone call lead >
      //      Calls from website visits), separate from the pre-existing
      //      "Calls from ads" action — that one only fires for calls placed
      //      via the ad's own call extension, not the website's tel: links.
      //      The two do not overlap and both roll up into the same "Phone
      //      call lead" goal in the Ads UI.
      const GADS_CALL_CONVERSION_ID = "AW-18043825480/AtkdCJPSkOAcEMja-5tD";

      document.addEventListener("click", (e) => {
        const el = e.target;
        if (!(el instanceof Element)) return;
        const link = el.closest('a[href^="tel:"]');
        if (!link) return;

        const href = link.getAttribute("href") || "";
        const label = link.closest("[data-tel-context]")?.getAttribute("data-tel-context")
          || document.title;

        if (typeof (window as any).gtag !== "function") return;

        (window as any).gtag("event", "phone_call_click", {
          event_category: "engagement",
          event_label: href,
          page_path: window.location.pathname,
          link_context: label,
        });

        (window as any).gtag("event", "conversion", {
          send_to: GADS_CALL_CONVERSION_ID,
        });
      });
    </script>
  </body>
</html>
