---
import ContentPage from "@/layouts/ContentPage.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import Icon from "@/components/Icons.astro";
import { getMeta } from "@/lib/rm";
import { C, KMS_PHONE, KMS_PHONE_HREF, KMS_EMAIL } from "@/lib/brand";
const seo = await getMeta("/contact", {
  title: "Request a Repair Quote · 40+ Yrs · Free Nationwide Pickup",
  description: "Request a free industrial repair quote. 24/7 emergency service, free nationwide pickup, 24-month warranty. Call 346-350-1464.",
  ogImage: "/images/kms-hero-bg.webp",
});
---
<ContentPage
  seo={seo}
  h1="Request a Repair Quote"
  subheading="Tell us about your equipment and a Kelsey Machine specialist will respond within one business hour. For emergencies, call our 24/7 line directly."
  bgImage="/images/kms-hero-bg.webp"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]}
  sidebar={false}
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">

    <div class="content-prose">
      <h2>Direct Contact</h2>
      <p>
        <strong>Phone:</strong> <a href={KMS_PHONE_HREF}>{KMS_PHONE}</a><br />
        <strong>Email:</strong> <a href={`mailto:${KMS_EMAIL}`}>{KMS_EMAIL}</a><br />
        <strong>Address:</strong> 814 Summer Park Drive, Building #600, Stafford, TX 77477
      </p>

      <h2>Hours</h2>
      <p>
        Shop hours: Monday–Friday, 7:00 a.m. – 5:00 p.m. Central<br />
        Emergency line: 24 hours a day, 7 days a week, every day of the year.
      </p>

      <h2>What to Expect</h2>
      <ul>
        <li>Quote response within one business hour during shop hours; immediate during emergencies</li>
        <li>Written failure analysis before any repair work is authorized</li>
        <li>Itemized quote with no hidden charges</li>
        <li>Free pickup and delivery anywhere in the U.S., Canada, or Mexico</li>
        <li>24-month written warranty on every rebuild</li>
      </ul>

      <h2>For Emergencies</h2>
      <p>If your equipment is down and you need immediate response, call <a href={KMS_PHONE_HREF}>{KMS_PHONE}</a>. Don't wait for a callback — we answer the emergency line 24 hours a day.</p>
    </div>

    <div style={`background:linear-gradient(135deg, ${C.darkBg} 0%, ${C.blueDark} 100%);border-radius:4px;padding:2rem;height:fit-content`}>
      <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.4rem;color:white;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.5rem">
        Send Us Your Details
      </div>
      <p style="font-family:'Source Sans 3',sans-serif;font-size:0.95rem;color:rgba(255,255,255,0.65);margin-bottom:1.5rem">
        We'll respond within one business hour. For immediate help, call <a href={KMS_PHONE_HREF} style={`color:${C.green};text-decoration:none`}>{KMS_PHONE}</a>.
      </p>
      <QuoteForm client:load variant="contact" />
    </div>
  </div>
</ContentPage>
