---
import KmsLayout from "@/layouts/KmsLayout.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import Icon from "@/components/Icons.astro";
import { getMeta } from "@/lib/rm";
import { C, KMS_PHONE, KMS_PHONE_HREF, KMS_EMAIL } from "@/lib/brand";
import { INDUSTRIES } from "@/lib/industries-data";

const seo = await getMeta("/industries", {
  title: "Industries We Serve — Oil & Gas, Food, Wastewater, Mining",
  description: "Industrial rotating equipment repair for oil & gas, petrochemical, food & beverage, wastewater, power, pulp & paper, pharmaceutical, mining.",
  ogImage: "/images/industries-hero-bg.webp",
});
---
<KmsLayout seo={seo}>

  {/* Hero — green badge + quick-link pills */}
  <section style={`background:linear-gradient(135deg, rgba(10,25,45,0.92) 0%, rgba(30,80,128,0.78) 55%, rgba(26,37,53,0.85) 100%), url(/images/industries-hero-bg.webp) center/cover no-repeat;padding-top:7rem;padding-bottom:3.5rem;border-bottom:3px solid ${C.green}`}>
    <div class="max-w-7xl mx-auto px-4">
      <div class="inline-block mb-4" style={`background:${C.green};color:white;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;padding:0.3rem 0.75rem;border-radius:2px`}>
        Industries We Serve
      </div>
      <h1 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(2.5rem, 6vw, 4rem);color:white;text-transform:uppercase;letter-spacing:-0.02em;line-height:1.05;margin-bottom:1.25rem">
        ROTATING EQUIPMENT REPAIR<br /><span style={`color:${C.green}`}>ACROSS EVERY INDUSTRY</span>
      </h1>
      <p style="font-family:'Source Sans 3',sans-serif;font-size:1.1rem;color:rgba(255,255,255,0.75);max-width:680px;line-height:1.7;margin-bottom:2rem">
        From oil fields to food plants, from paper mills to pharmaceutical facilities — Kelsey Machine Services repairs the rotating equipment that keeps your operation running. Over 30 years of Gulf Coast industrial experience, available 24/7.
      </p>
      {/* Quick-link pills */}
      <div class="flex flex-wrap gap-2">
        {INDUSTRIES.map((ind) => (
          <a href={`#${ind.id}`} class="no-underline" style="font-family:'Barlow',sans-serif;font-weight:600;font-size:0.75rem;letter-spacing:0.06em;text-transform:uppercase;color:rgba(255,255,255,0.75);background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:2px;padding:0.4rem 0.85rem">
            {ind.icon} {ind.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Industry sections — alternating image / content */}
  <div style="background:#f4f6f9">
    <div class="max-w-7xl mx-auto px-4" style="padding-top:3rem;padding-bottom:3rem">
      <div class="flex flex-col gap-16">
        {INDUSTRIES.map((ind, idx) => {
          const reverse = idx % 2 === 1;
          return (
            <section id={ind.id} style="scroll-margin-top:90px">
              <div class={`grid grid-cols-1 lg:grid-cols-2 gap-10 items-start ${reverse ? "lg:[&>*:first-child]:order-2" : ""}`}>

                {/* Image */}
                <div style="aspect-ratio:1/1;overflow:hidden;border-radius:4px;box-shadow:0 4px 24px rgba(0,0,0,0.12)">
                  <img src={ind.image} alt={`${ind.name} rotating equipment repair — Kelsey Machine Services`} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>

                {/* Content */}
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <span style="font-size:1.5rem">{ind.icon}</span>
                    <span style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;color:${C.green}`}>Industry</span>
                  </div>
                  <h2 style={`font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(1.75rem, 4vw, 2.75rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:-0.01em;line-height:1.05;margin-bottom:0.5rem`}>
                    {ind.name}
                  </h2>
                  <p style={`font-family:'Barlow',sans-serif;font-weight:600;font-size:1rem;color:${C.green};margin-bottom:1.25rem;letter-spacing:0.02em`}>
                    {ind.tagline}
                  </p>
                  {ind.body.map((para) => (
                    <p style="font-family:'Source Sans 3',sans-serif;font-size:0.97rem;color:#3a4a5c;line-height:1.75;margin-bottom:1rem">
                      {para}
                    </p>
                  ))}

                  {/* Equipment checklist */}
                  <div style={`background:white;border:1px solid #dde3ec;border-left:4px solid ${C.green};border-radius:4px;padding:1.25rem;margin-top:1.5rem`}>
                    <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.8rem;letter-spacing:0.12em;text-transform:uppercase;color:${C.blueDark};margin-bottom:0.75rem`}>
                      Equipment We Service
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
                      {ind.equipment.map((eq) => (
                        <div class="flex items-center gap-2">
                          <span style={`color:${C.green};flex-shrink:0;display:inline-flex`}><Icon name="check-circle" size={13} /></span>
                          <span style="font-family:'Source Sans 3',sans-serif;font-size:0.88rem;color:#3a4a5c">{eq}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* CTA */}
                  <div class="flex flex-wrap gap-3 mt-5">
                    <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.06em;padding:0.75rem 1.5rem;border-radius:2px`}>
                      <Icon name="phone" size={16} /> Call Now — {KMS_PHONE}
                    </a>
                    <a href={`mailto:${KMS_EMAIL}`} class="inline-flex items-center gap-2 no-underline" style={`background:transparent;color:${C.blueDark};border:2px solid ${C.blueDark};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:0.9rem;letter-spacing:0.06em;padding:0.55rem 1.25rem;border-radius:2px`}>
                      <Icon name="mail" size={15} /> Email Us
                    </a>
                  </div>
                </div>
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>

  {/* Bottom contact form section */}
  <section style={`background:${C.blueDark};padding:4rem 0`}>
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:clamp(1.75rem, 4vw, 2.75rem);color:white;text-transform:uppercase;letter-spacing:-0.01em;margin-bottom:1rem">
            SERVE YOUR INDUSTRY BETTER.<br /><span style={`color:${C.green}`}>START WITH A FREE QUOTE.</span>
          </h2>
          <p style="font-family:'Source Sans 3',sans-serif;font-size:1rem;color:rgba(255,255,255,0.7);line-height:1.7;margin-bottom:2rem">
            No matter your industry, Kelsey Machine Services has the expertise to repair your rotating equipment faster, better, and with a warranty that backs it up. Tell us what you need and we'll respond within the hour during business hours — or immediately for emergencies.
          </p>
          <div class="flex flex-col gap-3">
            <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 no-underline" style={`color:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;letter-spacing:0.04em`}>
              <Icon name="phone" size={18} /> {KMS_PHONE} — Available 24/7
            </a>
            <a href={`mailto:${KMS_EMAIL}`} class="inline-flex items-center gap-2 no-underline" style="color:rgba(255,255,255,0.7);font-family:'Source Sans 3',sans-serif;font-size:0.95rem">
              <Icon name="mail" size={16} /> {KMS_EMAIL}
            </a>
          </div>
        </div>
        <div style={`background:linear-gradient(135deg, ${C.darkBg} 0%, ${C.blueDark} 100%);border-radius:4px;padding:1.5rem`}>
          <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;color:white;text-transform:uppercase;margin-bottom:0.25rem">Get a Free Repair Quote</div>
          <p style="font-family:'Source Sans 3',sans-serif;font-size:0.85rem;color:rgba(255,255,255,0.55);margin-bottom:1rem">Available 24/7 · Respond within the hour</p>
          <QuoteForm client:visible variant="contact" />
        </div>
      </div>
    </div>
  </section>
</KmsLayout>
