---
import ContentPage from "@/layouts/ContentPage.astro";
import { getMeta } from "@/lib/rm";
import { SERVICES } from "@/lib/homepage-data";
import { C } from "@/lib/brand";

const seo = await getMeta("/services", {
  title: "Industrial Repair Services · 40+ Yrs · Free Pickup",
  description: "Full service rotating equipment repair — centrifuge, gearbox, pump, blower, compressor, fluid end. 24-month warranty, free nationwide pickup.",
  ogImage: "/images/kms-hero-bg.webp",
});
---
<ContentPage
  seo={seo}
  h1="Industrial Repair Services"
  subheading="Six dedicated repair lines for rotating equipment, backed by 40+ years of in-house machining, dynamic balancing, and the longest written warranty in the industry."
  bgImage="/images/kms-hero-bg.webp"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Services" }]}
  sidebar={false}
>
  <div class="content-prose max-w-4xl mx-auto">
    <p>Kelsey Machine Services rebuilds rotating equipment for customers across all 50 states, Canada, and Mexico. We specialize in six core service lines — every one of them backed by the same 24-month written warranty, free nationwide pickup, and 24/7 emergency response that has kept industrial customers coming back for 40+ years.</p>

    <p>Every repair starts with a complete teardown and written failure analysis. You'll know exactly what failed, why it failed, and what it costs to fix before any work is authorized. No surprises at invoice. Every rebuild ships with full documentation, dynamic balancing records, and a warranty you can actually rely on.</p>

    <h2>Our Service Lines</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      {SERVICES.map((s) => (
        <a href={s.href} class="block no-underline border border-gray-200 hover:border-kms-green rounded-sm overflow-hidden transition-colors bg-white">
          <div class="aspect-[4/3] overflow-hidden bg-gray-100">
            <img src={s.image} alt={s.title} loading="lazy" class="w-full h-full object-cover" />
          </div>
          <div class="p-5">
            <h3 style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.35rem;color:${C.blueDark};text-transform:uppercase;margin:0 0 0.5rem`}>{s.title}</h3>
            <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.95rem;color:${C.textMid};line-height:1.65;margin:0`}>{s.description}</p>
          </div>
        </a>
      ))}
    </div>

    <h2>Industries We Serve</h2>
    <p>Oil & gas, petrochemical and refining, food and beverage processing, wastewater treatment, power generation, pulp and paper, pharmaceutical, and general industrial manufacturing. <a href="/industries">See the full list of industries we serve →</a></p>

    <h2>Why Kelsey Machine</h2>
    <ul>
      <li><strong>24-month rebuilt warranty</strong> — the longest in the rotating equipment repair industry.</li>
      <li><strong>Free nationwide pickup & delivery</strong> across all 50 states, Canada, and Mexico.</li>
      <li><strong>24/7 emergency response</strong> — we answer the phone day or night.</li>
      <li><strong>All major brands serviced</strong> — Alfa Laval, Andritz, Falk, Sumitomo, Lufkin, Bosch Rexroth, NOV, Gardner Denver, and many more.</li>
      <li><strong>Often faster than the OEM</strong> — 10-day centrifuge rebuilds and 72-hour emergency hydraulic pump repair are routine.</li>
      <li><strong>Written failure analysis</strong> with every repair — root cause, not just symptoms.</li>
    </ul>
  </div>
</ContentPage>
