---
import ServicePage from "@/layouts/ServicePage.astro";
import { getMeta } from "@/lib/rm";
import { data } from "@/lib/services/fluid-power-end-repair";
const seo = await getMeta("/fluid-end-power-end-repair", {
  title: "Fluid End & Power End Repair Specialists · 40+ Yrs · Free Pickup",
  description: data.fallback.description,
  ogImage: data.fallback.ogImage,
  canonical: "https://www.kmstx.com/services/fluid-power-end-repair",
});
---
<ServicePage data={data} seo={seo} />
