---
import ServicePage from "@/layouts/ServicePage.astro";
import { getMeta } from "@/lib/rm";
import { data } from "@/lib/services/industrial-blower-repair";
const seo = await getMeta("/blower-vacuum-pump-repair", {
  title: "Blower & Vacuum Pump Repair — Free Pickup · 40+ Yrs Experience",
