---
/**
 * Blog post detail — getStaticPaths fetches all post slugs at build,
 * then renders each post's content using its embedded WP REST data.
 *
 * SEO comes from the SEO Connect module if RM has an entry for the path;
 * otherwise we fall back to the post's own title + excerpt.
 */
import ContentPage from "@/layouts/ContentPage.astro";
import { getMeta } from "@/lib/rm";
import { C } from "@/lib/brand";

interface Post {
  id: number; slug: string; date: string; link: string;
  title: { rendered: string };
  content: { rendered: string };
  excerpt: { rendered: string };
  _embedded?: {
    "wp:featuredmedia"?: Array<{ source_url: string; alt_text: string }>;
    "author"?: Array<{ name: string }>;
    "wp:term"?: Array<Array<{ name: string; slug: string }>>;
  };
}

// Entity pattern covers named (&amp;), decimal (&#8217;) and hex (&#x2019;)
// forms — WP "rendered" strings routinely use the numeric ones (curly
// apostrophes, dashes), which the old /&[a-z]+;/ pattern missed, leaving
// literal "&#8217;" text in the h1 and meta description. Keep in sync with
// the identical helper in blog/index.astro.
function strip(html: string) { return html.replace(/<[^>]*>/g, "").replace(/&#?[a-z0-9]+;/gi, " ").trim(); }
function fmtDate(iso: string) {
  try { return new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }); }
  catch { return iso; }
}

export async function getStaticPaths() {
  const CMS = (import.meta.env.PUBLIC_CMS_URL as string | undefined) || "https://cms.kmstx.com";
  try {
    const res = await fetch(`${CMS}/wp-json/wp/v2/posts?per_page=100&_embed=wp:featuredmedia,author,wp:term&status=publish`);
    if (!res.ok) {
      console.warn(`[blog] /wp-json/wp/v2/posts returned ${res.status}`);
      return [];
    }
    const posts = (await res.json()) as Post[];
    return posts.map((post) => ({
      params: { slug: post.slug },
      props:  { post },
    }));
  } catch (err) {
    console.warn("[blog] getStaticPaths fetch failed:", err);
    return [];
  }
}

const { post } = Astro.props;
const title = strip(post.title.rendered);
const excerpt = strip(post.excerpt.rendered).slice(0, 160);
const img = post._embedded?.["wp:featuredmedia"]?.[0];
const author = post._embedded?.["author"]?.[0]?.name;
const categories = post._embedded?.["wp:term"]?.[0] || [];

const seo = await getMeta(`/blog/${post.slug}`, {
  title: `${title} | KMS Blog`,
  description: excerpt,
  ogImage: img?.source_url,
});
---
<ContentPage
  seo={seo}
  h1={title}
  subheading={excerpt}
  bgImage={img?.source_url || "/images/kms-hero-bg.webp"}
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: title }]}
>
  <div class="content-prose">
    <div class="flex flex-wrap items-center gap-3 mb-6" style={`font-family:'Barlow',sans-serif;font-size:0.85rem;color:${C.textMid}`}>
      <span>{fmtDate(post.date)}</span>
      {author && <><span>·</span><span>{author}</span></>}
      {categories.length > 0 && <>
        <span>·</span>
        <span>
          {categories.map((cat: { name: string; slug: string }, i: number) => (
            <>{i > 0 && ", "}<span style={`color:${C.green}`}>{cat.name}</span></>
          ))}
        </span>
      </>}
    </div>

    {/* SECURITY NOTE (2026-08-11 review): this renders raw WP post HTML
        unsanitized. Threat model: any WP author account (not an anonymous
        site visitor) could inject a <script> here — that requires
        compromising the CMS's own auth, a separate already-authenticated
        system, not this frontend. This is a known, common trade-off for
        headless-WP builds and was flagged as lower-priority/accepted risk
        rather than must-fix. NOT patched with a hand-rolled regex sanitizer
        here on purpose — regex-based HTML sanitization is notoriously easy
        to bypass and would give false confidence. If this needs hardening,
        the correct fix is a real sanitizer library (e.g. isomorphic-
        dompurify) run at build time — that adds a new npm dependency, which
        needs pnpm-lock.yaml regenerated; do that as its own deliberate,
        tested change, not bundled into an unrelated content/design pass
        (a same-session dependency add broke the Vercel build once already
        today — see LP page commit history around 2026-08-11 20:45). */}
    <div set:html={post.content.rendered} />

    <hr class="my-10 border-gray-200" />
    <p><a href="/blog">← Back to all blog posts</a></p>
  </div>
</ContentPage>
