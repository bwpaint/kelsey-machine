---
/**
 * Post-submit confirmation page. Every successful quote/landing form submit
 * redirects here (see QuoteForm.tsx / LpQuoteForm.tsx).
 *
 * Measurement roles:
 *  - GA4: clean /thank-you page_view → mark as a key event in GA4 admin.
 *  - Google Ads: fires the SECONDARY (observation-only) conversion
 *    "KMS Real Lead Form Submit" as a validation channel. The PRIMARY
 *    conversion ("KMS Quote Form Submit") fires on the form's success
 *    callback before the redirect — that one trains bidding; this one just
 *    watches. If the two ever diverge, something broke.
 *  - Remarketing: visitors here are converters → exclusion audience seed.
 *
 * noindex: this page means nothing to searchers and must not rank.
 */
import ContentPage from "@/layouts/ContentPage.astro";
import { getMeta } from "@/lib/rm";
import { KMS_PHONE, KMS_PHONE_HREF } from "@/lib/brand";

const STEPS = [
  {
    n: "1",
    title: "Within 1 business hour",
    body: "A KMS repair specialist calls you back to talk through the equipment and the failure. Keep your phone handy — the call comes from",
    phone: true,
  },
  {
    n: "2",
    title: "Straight answers",
    body: "We'll tell you whether it's a repair, a rebuild, or not worth fixing, and what it will roughly take. No surprises at invoice.",
  },
  {
    n: "3",
    title: "Freight handled",
    body: "If the unit needs to come to our Stafford, TX shop, we coordinate pickup from anywhere in the U.S. or Canada as part of the job.",
  },
];
const seo = await getMeta("/thank-you", {
  title: "Request Received · Kelsey Machine Services",
  description:
    "We got your request. A repair specialist will contact you within one business hour.",
  noindex: true,
});
---

<ContentPage
  seo={seo}
  h1="Got It — Your Request Is In"
  subheading="A repair specialist is reviewing your equipment details right now."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Request Received" }]}
  sidebar={false}
>
  <div class="content-prose max-w-3xl mx-auto ty-wrap">
    <h2>What happens next</h2>

    <ol class="ty-steps">
      {STEPS.map((s) => (
        <li class="ty-step">
          <span class="ty-step__num" aria-hidden="true">{s.n}</span>
          <div>
            <span class="ty-step__title">{s.title}</span>
            <p class="ty-step__body">
              {s.body}
              {s.phone && (
                <> <a href={KMS_PHONE_HREF} class="ty-inline-tel">{KMS_PHONE}</a>.</>
              )}
            </p>
          </div>
        </li>
      ))}
    </ol>

    {/* Emergency CTA — the one action worth taking before the callback lands */}
    <aside class="ty-emergency" aria-label="Emergency service">
      <div class="ty-emergency__kicker">Equipment down right now?</div>
      <p class="ty-emergency__copy">
        Don't wait on the callback. Our emergency line is answered day and
        night, every day of the year.
      </p>
      <div class="ty-emergency__actions">
        <a href={KMS_PHONE_HREF} class="ty-btn ty-btn--primary">Call {KMS_PHONE}</a>
        <a href="/emergency-service" class="ty-btn ty-btn--ghost">24/7 Emergency Service</a>
      </div>
    </aside>

    <h2>While you wait</h2>
    <div class="ty-cards">
      <a href="/warranty" class="ty-card">
        <span class="ty-card__title">24-Month Warranty</span>
        <span class="ty-card__body">
          Every KMS rebuild ships with a written 24-month warranty — the longest
          in the rotating equipment repair industry.
        </span>
        <span class="ty-card__link">See the warranty →</span>
      </a>
      <a href="/about" class="ty-card">
        <span class="ty-card__title">How We Work</span>
        <span class="ty-card__body">
          Texas' most trusted rotating equipment repair shop since 1983, serving
          all 50 states, Canada, and Mexico.
        </span>
        <span class="ty-card__link">About KMS →</span>
      </a>
    </div>
  </div>

  {/*
    is:global — this markup is slotted into ContentPage, so Astro's scoped
    styles would not match it (same trap that left .content-prose dead).
    Brand hexes are inlined rather than passed via define:vars, which does not
    combine reliably with is:global. Values mirror C{} in @/lib/brand.
  */}
  <style is:global>
    .ty-wrap { --tyGreen:#78A546; --tyGreenDark:#5E8535; --tyBlue:#1E5080; --tyDark:#1A2535; --tyLight:#F4F7FA; --tyTextMid:#3D5166; padding-bottom: 1rem; }

    /* Numbered steps — replaces the bare <ol> that rendered as flat text */
    .ty-steps { list-style: none; padding: 0; margin: 0 0 2.5rem; display: grid; gap: 0.75rem; }
    .ty-step {
      display: flex; gap: 1rem; align-items: flex-start; margin: 0;
      background: var(--tyLight); border-left: 3px solid var(--tyGreen);
      border-radius: 4px; padding: 1.1rem 1.25rem;
    }
    .ty-step__num {
      flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%;
      background: var(--tyGreen); color: #fff;
      font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.1rem;
      display: flex; align-items: center; justify-content: center; line-height: 1;
    }
    .ty-step__title {
      display: block; font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
      font-size: 1.15rem; color: var(--tyBlue); text-transform: uppercase;
      letter-spacing: 0.02em; margin-bottom: 0.15rem;
    }
    .ty-step__body {
      font-family: 'Source Sans 3', sans-serif; font-size: 1rem;
      color: var(--tyTextMid); line-height: 1.65; margin: 0;
    }
    .ty-inline-tel { color: var(--tyGreen); font-weight: 700; text-decoration: none; white-space: nowrap; }
    .ty-inline-tel:hover { text-decoration: underline; }

    /* Emergency CTA */
    .ty-emergency {
      background: var(--tyDark); border-radius: 4px;
      padding: 1.75rem; margin: 0 0 2.5rem; color: #fff;
    }
    .ty-emergency__kicker {
      font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
      font-size: 1.5rem; color: var(--tyGreen); text-transform: uppercase;
      letter-spacing: 0.02em; margin-bottom: 0.4rem;
    }
    .ty-emergency__copy {
      font-family: 'Source Sans 3', sans-serif; font-size: 1rem;
      color: rgba(255,255,255,0.75); line-height: 1.6; margin: 0 0 1.25rem;
    }
    .ty-emergency__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .ty-btn {
      font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1rem;
      text-transform: uppercase; letter-spacing: 0.03em; text-decoration: none;
      padding: 0.75rem 1.5rem; border-radius: 2px; display: inline-block;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .ty-btn--primary { background: var(--tyGreen); color: #fff; }
    .ty-btn--primary:hover { background: var(--tyGreenDark); text-decoration: none; }
    .ty-btn--ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.3); }
    .ty-btn--ghost:hover { background: rgba(255,255,255,0.1); text-decoration: none; }

    /* Reassurance cards */
    .ty-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .ty-card {
      display: flex; flex-direction: column; gap: 0.4rem;
      background: #fff; box-shadow: inset 0 0 0 1px rgba(30,80,128,0.15);
      border-radius: 4px; padding: 1.25rem; text-decoration: none;
      transition: box-shadow 0.15s ease, transform 0.15s ease;
    }
    .ty-card:hover { box-shadow: inset 0 0 0 1px var(--tyGreen), 0 4px 14px rgba(26,37,53,0.1); transform: translateY(-2px); text-decoration: none; }
    .ty-card__title {
      font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.15rem;
      color: var(--tyBlue); text-transform: uppercase; letter-spacing: 0.02em;
    }
    .ty-card__body { font-family: 'Source Sans 3', sans-serif; font-size: 0.95rem; color: var(--tyTextMid); line-height: 1.6; }
    .ty-card__link { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 0.95rem; color: var(--tyGreen); text-transform: uppercase; letter-spacing: 0.02em; margin-top: auto; padding-top: 0.4rem; }

    @media (max-width: 640px) {
      .ty-cards { grid-template-columns: 1fr; }
      .ty-emergency { padding: 1.35rem; }
      .ty-emergency__actions .ty-btn { flex: 1 1 100%; text-align: center; }
    }
  </style>

  <script is:inline>
    // Secondary (observation-only) Google Ads conversion — "KMS Real Lead
    // Form Submit". Validates the primary form-event conversion; demoted to
    // Secondary in Google Ads so it never trains bidding. Session-guarded so
    // refreshes and back-navigation don't refire it.
    (function () {
      try {
        if (sessionStorage.getItem("kms_ty_conv")) return;
        sessionStorage.setItem("kms_ty_conv", "1");
      } catch (e) {
        /* storage unavailable — fire anyway */
      }
      if (typeof gtag === "function") {
        gtag("event", "conversion", {
          send_to: "AW-18043825480/v45VCKqj89scEMja-5tD",
        });
      }
    })();
  </script>
</ContentPage>
