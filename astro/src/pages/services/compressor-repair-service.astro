---
import ServicePage from "@/layouts/ServicePage.astro";
import { getMeta } from "@/lib/rm";
import { data } from "@/lib/services/industrial-compressors";
const seo = await getMeta("/services/compressor-repair-service", {
  title: "Compressor Repair Service — 40+ Yrs · Free Nationwide Pickup",
  description: data.fallback.description,
  ogImage: data.fallback.ogImage,
  canonical: "https://www.kmstx.com/services/industrial-compressors",
});
---
<ServicePage data={data} seo={seo} />
