---
import ServicePage from "@/layouts/ServicePage.astro";
import { getMeta } from "@/lib/rm";
import { data } from "@/lib/services/centrifuge-repair";
const seo = await getMeta("/services/centrifuge-repair-service", {
  title: "Centrifuge Repair Service — 40+ Yrs · Free Nationwide Pickup",
  description: data.fallback.description,
  ogImage: data.fallback.ogImage,
  canonical: "https://www.kmstx.com/services/centrifuge-repair",
});
---
<ServicePage data={data} seo={seo} />
