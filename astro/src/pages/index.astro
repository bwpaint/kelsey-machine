---
/**
 * KMS Homepage — full visual port from client/src/pages/Home.tsx
 *
 * Section order matches the Vite client exactly:
 *   Hero -> TrustBar -> Stats -> Services -> WhyKMS -> Testimonials
 *   -> Industries -> Brands -> FAQ -> NewsletterBar -> Footer
 *
 * Body content is in static HTML for crawlers. React islands:
 *   - QuoteForm (hero + FAQ sidebar)
 *   - Testimonials (carousel state)
 *   - NewsletterForm (signup)
 */
import KmsLayout from "@/layouts/KmsLayout.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import Testimonials from "@/components/Testimonials.tsx";
import NewsletterBar from "@/components/NewsletterBar.astro";
import Icon from "@/components/Icons.astro";
import { getMeta } from "@/lib/rm";
import { SERVICES, STATS, FAQS, INDUSTRIES, BRANDS, TRUST_BAR, TESTIMONIALS, WHY_KMS, HERO_TRUST_BADGES } from "@/lib/homepage-data";
import { C, KMS_PHONE, KMS_PHONE_HREF, KMS_EMAIL } from "@/lib/brand";

const seo = await getMeta("/", {
  title: "Industrial Rotating Equipment Repair · 40+ Yrs · Free Pickup",
  description: "Centrifuge, gearbox, pump, blower, compressor & fluid-end repair. 24-month warranty, free nationwide pickup, 24/7 emergency service. Serving all 50 states.",
  ogImage: "/images/kms-hero-bg.webp",
});
---
<KmsLayout seo={seo}>

  {/* ───── Hero ───── */}
  <section class="relative min-h-screen flex items-center" style="padding-top:68px" aria-label="Hero">
    {/* BG image */}
    <div class="absolute inset-0 bg-cover" style="background-image:url(/images/kms-hero-bg.webp);background-position:left center"></div>
    {/* Gradient overlay */}
    <div class="absolute inset-0" style="background:linear-gradient(105deg, rgba(30,80,128,0.72) 0%, rgba(30,80,128,0.78) 50%, rgba(26,37,53,0.80) 100%)"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 pt-2 pb-12 lg:pt-3 lg:pb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-start">

        {/* Left — headline + CTAs */}
        <div>
          <div class="mb-3" style={`font-family:'Barlow',sans-serif;font-weight:600;font-size:0.78rem;color:${C.greenLight};letter-spacing:0.1em;text-transform:uppercase`}>
            Houston, TX · Serving All 50 States + Canada &amp; Mexico
          </div>
          <h1 class="text-white mb-5" style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2.6rem, 4.5vw, 3.8rem);line-height:1.05;letter-spacing:0.01em;text-transform:uppercase">
            YOUR PARTNER IN<br />
            <span style={`color:${C.green}`}>ROTATING EQUIPMENT</span><br />
            UPTIME
          </h1>
          <p style={`font-family:'Source Sans 3',sans-serif;font-size:1.1rem;color:${C.textLight};line-height:1.7;max-width:520px;margin-bottom:1.5rem`}>
            Kelsey Machine Services delivers expert repair, rebuild, and maintenance for centrifuges, gearboxes, pumps, blowers, and hydraulic drives — backed by an industry-leading <strong style={`color:${C.greenLight}`}>24-month warranty</strong> and available <strong style={`color:${C.greenLight}`}>24/7 for emergencies</strong>.
          </p>

          {/* Trust badges */}
          <div class="flex flex-wrap gap-3 mb-8">
            {HERO_TRUST_BADGES.map((b) => (
              <div class="flex items-center gap-2 px-3 py-1.5" style={`background:rgba(120,165,70,0.15);border:1px solid rgba(120,165,70,0.4);color:${C.greenLight};font-family:'Barlow',sans-serif;font-weight:600;font-size:0.78rem;letter-spacing:0.05em;border-radius:2px`}>
                <Icon name={b.iconName as any} size={13} /> {b.text}
              </div>
            ))}
          </div>

          <div class="flex flex-wrap gap-4">
            <a href="#contact" class="inline-flex items-center gap-2 text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1rem;padding:0.8rem 2rem;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase`}>
              Get a Free Quote <Icon name="arrow-right" size={16} />
            </a>
            <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 text-white no-underline border-2 border-white/40" style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1rem;padding:0.8rem 2rem;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase">
              <Icon name="phone" size={16} /> Call Now
            </a>
          </div>
        </div>

        {/* Right — quote form (React island) */}
        <div style={`background:rgba(26,37,53,0.80);border:1px solid rgba(120,165,70,0.35);padding:1.5rem 2rem 2rem 2rem;backdrop-filter:blur(12px);border-radius:2px`}>
          <div style={`font-family:'Barlow',sans-serif;font-weight:600;font-size:0.78rem;color:${C.green};letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.25rem`}>
            Get Equipment Help Now
          </div>
          <QuoteForm client:load variant="hero" />

          {/* Trust badges row */}
          <div style="margin-top:1.25rem;border-top:1px solid rgba(255,255,255,0.1);padding-top:1.25rem">
            <div class="flex flex-wrap gap-2">
              {[
                { label: "40+ Years in Business", icon: "🏆" },
                { label: "TX Licensed & Insured", icon: "✅" },
                { label: "BBB Accredited", icon: "🔒" },
                { label: "AGMA Member", icon: "⚙️" },
              ].map((b) => (
                <div class="flex items-center gap-1.5" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:2px;padding:0.25rem 0.6rem;font-family:'Barlow',sans-serif;font-weight:600;font-size:0.72rem;color:rgba(255,255,255,0.75);letter-spacing:0.03em">
                  <span>{b.icon}</span> {b.label}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Diagonal cut to light section */}
    <div class="absolute bottom-0 left-0 right-0" style="height:60px;overflow:hidden">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width:100%;height:100%">
        <polygon points="0,60 1440,0 1440,60" fill={C.lightBg} />
      </svg>
    </div>
  </section>

  {/* ───── Trust Bar ───── */}
  <section style={`background:${C.lightBg};padding-top:3.5rem;padding-bottom:3.5rem`} aria-label="Key differentiators">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {TRUST_BAR.map((item) => (
          <div class="flex flex-col gap-2">
            <div style="width:52px;height:52px;background:rgba(120,165,70,0.12);border:1px solid rgba(120,165,70,0.3);border-radius:2px;display:flex;align-items:center;justify-content:center">
              <span style={`color:${C.green};display:inline-flex`}><Icon name={item.iconName as any} size={28} /></span>
            </div>
            <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.26rem;color:${C.blueDark}`}>
              {item.title}
            </div>
            <p style={`font-family:'Source Sans 3',sans-serif;font-size:1.06rem;color:${C.textMid};line-height:1.55`}>
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ───── Stats Strip ───── */}
  <section style={`background:linear-gradient(135deg, ${C.blueDark} 0%, ${C.blueMid} 60%, ${C.blueSky} 100%);padding:4rem 0`} aria-label="Company statistics">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {STATS.map(({ value, label }) => (
        <div>
          <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2.5rem, 5vw, 3.8rem);color:${C.green};line-height:1`}>{value}</div>
          <div class="text-white/75 mt-2" style="font-family:'Barlow',sans-serif;font-weight:500;font-size:0.82rem;letter-spacing:0.1em;text-transform:uppercase">{label}</div>
        </div>
      ))}
    </div>
  </section>

  {/* ───── Services ───── */}
  <section id="services" class="bg-white" style="padding:5rem 0" aria-label="Our services">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-12">
        <div class="text-kms-green text-xs uppercase tracking-widest mb-2" style="font-family:'Barlow',sans-serif;font-weight:600;letter-spacing:0.1em">What We Fix</div>
        <div style={`width:50px;height:3px;background:${C.green};margin-bottom:0.75rem`}></div>
        <h2 style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(2rem, 4vw, 3rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:0.01em`}>
          COMPREHENSIVE ROTATING EQUIPMENT<br />REPAIR SERVICES
        </h2>
        <p style={`font-family:'Source Sans 3',sans-serif;font-size:1.05rem;color:${C.textMid};max-width:640px;margin-top:0.75rem;line-height:1.7`}>
          From emergency centrifuge rebuilds to scheduled gearbox overhauls, Kelsey Machine Services handles every aspect of rotating equipment repair with precision and speed. We service all major brands and back every repair with our industry-leading warranty.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {SERVICES.map((s) => (
          <article style={`background:${C.lightBg};box-shadow:0 2px 12px rgba(30,80,128,0.08);border-radius:2px;overflow:hidden`}>
            <a href={s.href} class="block relative no-underline" style="height:200px;overflow:hidden">
              <img src={s.image} alt={`${s.title} — Kelsey Machine Services`} loading="lazy" class="w-full h-full object-cover" style="transition:transform 0.35s ease" />
              <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(30,80,128,0.65) 0%, transparent 55%)"></div>
              <div class="absolute" style={`bottom:10px;left:12px;font-family:'Barlow',sans-serif;font-weight:600;font-size:0.68rem;color:${C.greenLight};letter-spacing:0.12em;text-transform:uppercase`}>
                {s.keyword}
              </div>
            </a>
            <div style="padding:1.25rem">
              <h3 style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.3rem;margin-bottom:0.5rem`}>
                <a href={s.href} class="no-underline" style={`color:${C.blueDark}`}>{s.title}</a>
              </h3>
              <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.65;margin-bottom:1rem`}>{s.description}</p>
              <a href={s.href} class="inline-flex items-center gap-2 text-white no-underline" style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.82rem;padding:0.5rem 1.25rem;border-radius:2px;letter-spacing:0.06em;text-transform:uppercase`}>
                Learn More <Icon name="arrow-right" size={14} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ───── Why KMS ───── */}
  <section id="why-kms" style={`background:${C.lightBg};padding:5rem 0`} aria-label="Why choose Kelsey Machine Services">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-16 items-start">

        {/* Left: shop photo + 40+ badge + form */}
        <div>
          <div class="relative mb-8">
            <img src="/images/gearbox-open.webp" alt="Kelsey Machine Services professional repair facility" loading="lazy" style="width:100%;height:380px;object-fit:cover;border-radius:2px;box-shadow:0 8px 40px rgba(30,80,128,0.18);display:block" />
            <div style={`position:absolute;bottom:-16px;right:-16px;background:${C.green};width:110px;height:110px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:1rem;border-radius:2px`}>
              <div style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:2.2rem;line-height:1;color:white">40+</div>
              <div style="font-family:'Barlow',sans-serif;font-weight:600;font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:white;line-height:1.3">Years of Expertise</div>
            </div>
          </div>
          <div style={`background:${C.darkBg2};border:1px solid rgba(120,165,70,0.3);border-radius:2px;padding:1.5rem;margin-top:1rem`}>
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;color:white;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.25rem">
              Get a Free Repair Quote
            </div>
            <p style="font-family:'Source Sans 3',sans-serif;font-size:0.85rem;color:rgba(255,255,255,0.55);margin-bottom:1rem">
              Available 24/7 · Respond within the hour
            </p>
            <QuoteForm client:visible variant="contact" />
          </div>
        </div>

        {/* Right: heading + 6 reasons */}
        <div>
          <div class="text-kms-green text-xs uppercase tracking-widest mb-3" style="font-family:'Barlow',sans-serif;font-weight:600;letter-spacing:0.1em">The KMS Advantage</div>
          <div style={`width:50px;height:3px;background:${C.green};margin-bottom:0.75rem`}></div>
          <h2 class="mb-6" style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.8rem, 3.5vw, 2.8rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:0.01em`}>
            WHY INDUSTRY LEADERS<br />CHOOSE KELSEY MACHINE
          </h2>
          <div class="grid gap-5">
            {WHY_KMS.map((r) => (
              <div class="flex gap-4">
                <div style="flex-shrink:0;margin-top:2px">
                  <span style={`color:${C.green};display:inline-flex`}>
                    <Icon name={(r.iconName === "check" ? "check-circle" : r.iconName) as any} size={24} />
                  </span>
                </div>
                <div>
                  <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;color:${C.blueDark};margin-bottom:0.25rem`}>{r.title}</div>
                  <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.88rem;color:${C.textMid};line-height:1.65`}>{r.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ───── Testimonials (React island for carousel) ───── */}
  <section id="testimonials" class="bg-white" style="padding:5rem 0" aria-label="Customer testimonials">
    <div class="max-w-7xl mx-auto px-4">
      <Testimonials client:visible testimonials={TESTIMONIALS} />
    </div>
  </section>

  {/* ───── Industries ───── */}
  <section id="industries" style={`background:linear-gradient(135deg, ${C.blueDark} 0%, ${C.blueMid} 100%);padding:4rem 0`} aria-label="Industries served">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div style={`color:${C.greenLight};font-family:'Barlow',sans-serif;font-weight:600;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.75rem`}>Sectors We Serve</div>
      <h2 class="text-white mb-10" style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.8rem, 3.5vw, 2.8rem);text-transform:uppercase;letter-spacing:0.01em">
        PROUDLY SERVING A WIDE RANGE<br />OF INDUSTRIES
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        {INDUSTRIES.map(({ name, icon, href }) => (
          <a href={href} class="flex flex-col items-center gap-2 py-4 px-2 no-underline" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:2px;transition:all 0.2s">
            <span style="font-size:1.75rem">{icon}</span>
            <span class="text-center" style="font-family:'Barlow',sans-serif;font-weight:600;font-size:0.7rem;color:rgba(255,255,255,0.8);letter-spacing:0.06em;text-transform:uppercase;line-height:1.3">{name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ───── Brands ───── */}
  <section style={`background:${C.darkBg};padding:3rem 0`} aria-label="Brands we service">
    <div class="max-w-7xl mx-auto px-4">
      <p class="text-center mb-6" style="font-family:'Barlow',sans-serif;font-weight:600;font-size:0.72rem;color:rgba(255,255,255,0.45);letter-spacing:0.15em;text-transform:uppercase">
        Brands We Service &amp; Repair
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {BRANDS.map((b) => (
          <span style="font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:0.9rem;color:rgba(255,255,255,0.6);letter-spacing:0.05em;padding:0.35rem 0.875rem;border:1px solid rgba(255,255,255,0.12);border-radius:2px">{b}</span>
        ))}
      </div>
    </div>
  </section>

  {/* ───── FAQ ───── */}
  <section id="faq" style={`background:${C.lightBg};padding:5rem 0`} aria-label="Frequently asked questions">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">

        {/* Left: FAQs (2/3) */}
        <div class="lg:col-span-2">
          <div class="text-center mb-10">
            <div class="text-kms-green text-xs uppercase tracking-widest mb-3" style="font-family:'Barlow',sans-serif;font-weight:600;letter-spacing:0.1em">Common Questions</div>
            <div style={`width:50px;height:3px;background:${C.green};margin:0 auto 0.75rem`}></div>
            <h2 style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.8rem, 3.5vw, 2.8rem);color:${C.blueDark};text-transform:uppercase;letter-spacing:0.01em`}>FREQUENTLY ASKED QUESTIONS</h2>
            <p style={`font-family:'Source Sans 3',sans-serif;font-size:1rem;color:${C.textMid};margin-top:0.75rem`}>
              Can't find your answer? Call us at <a href={KMS_PHONE_HREF} style={`color:${C.green};font-weight:600`}>{KMS_PHONE}</a> — we're available 24/7.
            </p>
          </div>
          <div style="border:1px solid rgba(30,80,128,0.15);border-radius:2px;overflow:hidden">
            {FAQS.map((f) => (
              <details class="group bg-white border-b border-blue-900/10 last:border-b-0">
                <summary class="cursor-pointer list-none flex justify-between items-center w-full" style={`padding:1.25rem 1.5rem;color:${C.blueDark};font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;letter-spacing:0.02em`}>
                  <span>{f.q}</span>
                  <span class="text-kms-green group-open:rotate-180 transition-transform flex-shrink-0">▾</span>
                </summary>
                <div style={`padding:0 1.5rem 1.25rem;font-family:'Source Sans 3',sans-serif;font-size:0.95rem;color:${C.textMid};line-height:1.7`}>{f.a}</div>
              </details>
            ))}
          </div>
        </div>

        {/* Right: form + warranty + free pickup callouts (1/3) */}
        <aside class="lg:col-span-1 flex flex-col gap-5">
          <div id="contact" style={`background:${C.darkBg2};border:1px solid rgba(120,165,70,0.3);border-radius:2px;padding:1.5rem`}>
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;color:white;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.25rem">
              Get a Free Repair Quote
            </div>
            <p style="font-family:'Source Sans 3',sans-serif;font-size:0.85rem;color:rgba(255,255,255,0.55);margin-bottom:1rem">
              Available 24/7 · Respond within the hour
            </p>
            <QuoteForm client:visible variant="contact" />
          </div>

          {/* Warranty callout */}
          <div style={`background:white;border:1px solid ${C.green}33;border-radius:2px;padding:1.5rem`}>
            <div class="flex items-center gap-2 mb-2">
              <span style={`color:${C.green};display:inline-flex`}><Icon name="shield" size={22} /></span>
              <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.blueDark};text-transform:uppercase;letter-spacing:0.02em`}>24-Month Warranty</div>
            </div>
            <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.6;margin:0 0 0.75rem`}>The longest written warranty in the rotating equipment repair industry. Every rebuild, every time.</p>
            <a href="/warranty" class="text-kms-green no-underline text-sm uppercase tracking-wider" style="font-family:'Barlow',sans-serif;font-weight:700">Learn more →</a>
          </div>

          {/* Free Pickup callout */}
          <div style={`background:white;border:1px solid ${C.green}33;border-radius:2px;padding:1.5rem`}>
            <div class="flex items-center gap-2 mb-2">
              <span style={`color:${C.green};display:inline-flex`}><Icon name="truck" size={22} /></span>
              <div style={`font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.1rem;color:${C.blueDark};text-transform:uppercase;letter-spacing:0.02em`}>Free Nationwide Pickup</div>
            </div>
            <p style={`font-family:'Source Sans 3',sans-serif;font-size:0.9rem;color:${C.textMid};line-height:1.6;margin:0`}>We coordinate inbound freight from anywhere in the U.S., Canada, or Mexico — at no charge.</p>
          </div>
        </aside>

      </div>
    </div>
  </section>

  {/* ───── NewsletterBar — "Experience the KMS Difference" ───── */}
  <NewsletterBar />

</KmsLayout>
