---
import Icon from "@/components/Icons.astro";
import NewsletterForm from "@/components/NewsletterForm.tsx";
import { C, KMS_PHONE, KMS_PHONE_HREF, KMS_EMAIL } from "@/lib/brand";
---

<section style={`background:${C.darkBg};border-top:3px solid ${C.green};padding:3.5rem 0`}>
  <div class="max-w-7xl mx-auto px-4">
    {/* Heading */}
    <div class="text-center mb-6">
      <div style={`font-family:'Barlow',sans-serif;font-weight:600;font-size:0.72rem;color:${C.green};letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.5rem`}>
        Ready to Get Started?
      </div>
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:clamp(1.8rem, 3.5vw, 2.8rem);color:white;text-transform:uppercase;letter-spacing:-0.01em;line-height:1.1;margin-bottom:0.75rem">
        Experience the <span style={`color:${C.green}`}>Kelsey Machine Difference</span>
      </h2>
      <p style="font-family:'Source Sans 3',sans-serif;font-size:1rem;color:rgba(255,255,255,0.65);max-width:560px;margin:0 auto 1.5rem">
        The right people, the right equipment, the right technology — keeping your operations running since 1984.
      </p>

      {/* Buttons row */}
      <div class="flex flex-wrap justify-center gap-4" style="margin-bottom:2.5rem">
        <a href={KMS_PHONE_HREF} class="inline-flex items-center gap-2 no-underline" style={`background:${C.green};color:white;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.08em;text-transform:uppercase;padding:0.75rem 2rem;border-radius:2px`}>
          <Icon name="phone" size={16} /> Call {KMS_PHONE}
        </a>
        <a href={`mailto:${KMS_EMAIL}`} class="inline-flex items-center gap-2 text-white no-underline" style="background:transparent;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.08em;text-transform:uppercase;padding:0.75rem 2rem;border-radius:2px;border:2px solid rgba(255,255,255,0.3)">
          <Icon name="mail" size={16} /> Email Us
        </a>
        <a href="/emergency-service" class="inline-flex items-center gap-2 no-underline" style={`background:transparent;color:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.08em;text-transform:uppercase;padding:0.75rem 2rem;border-radius:2px;border:2px solid ${C.green}66`}>
          <Icon name="clock" size={16} /> 24/7 Emergency Service
        </a>
      </div>
    </div>

    {/* Newsletter */}
    <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:2rem;margin-top:0.5rem">
      <div class="text-center mb-4">
        <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.1rem;color:white;text-transform:uppercase;letter-spacing:0.06em">
          Join Our Newsletter
        </div>
        <p style="font-family:'Source Sans 3',sans-serif;font-size:0.85rem;color:rgba(255,255,255,0.5);margin-top:0.25rem">
          Industry tips, maintenance alerts, and KMS news — no spam, ever.
        </p>
      </div>
      <NewsletterForm client:visible />
    </div>
  </div>
</section>
