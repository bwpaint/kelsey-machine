---
/**
 * Minimal PPC landing-page header — logo left, Call Now + Free Pickup
 * buttons grouped to the right. No nav links, no utility bar, no
 * Services dropdown.
 *
 * Landing pages exist to do ONE thing: get the visitor to fill out the
 * form (or call). Every nav link, dropdown, and secondary CTA in the
 * standard site Header.astro is a way for that visitor to leave before
 * converting. This strips all of that out but keeps two CTAs that point
 * BACK at the same conversion goal — Call Now (tel: link, converts by
 * phone instantly) and Free Pickup (scrolls to #quote).
 *
 * Layout: logo pinned left, then a button group to its right.
 *
 * DESKTOP (lg+): the row uses the SAME max-w-7xl/grid-cols-2/gap-12
 * structure as the hero section below it (LpPage.astro), so the header's
 * two "columns" are pixel-for-pixel identical to the hero's — logo sits
 * at the same left edge as the H1, and the button group centers within
 * the same column the "Industrial Blower Repair" kw-match box sits in.
 * A prior attempt centered the buttons within the flex "leftover space"
 * after the logo instead of the actual matching grid column, which
 * looked centered but didn't line up with anything below it — this
 * fixes that by making the columns genuinely the same ones.
 *
 * MOBILE/TABLET (below lg): unchanged — plain flex row, logo pinned
 * left (flex-shrink-0), button group taking the remaining width
 * (flex-1), capped at 50% of that remaining width at sm+ so there's a
 * visible gap instead of the buttons running edge to edge. Full-width
 * at the smallest phones — at ~320px two tap targets need the room.
 *
 * Both buttons are equal width (flex:1) AND equal height — forced via
 * min-height, since "Free Pickup / All 50 States" wraps to two lines
 * while "Call Now" is one, which used to make them different heights.
 *
 * Used only where KmsLayout is given headerVariant="minimal" (currently
 * LpPage.astro, i.e. the 5 PPC landing pages). Header.astro is completely
 * untouched — this is a separate, additive component.
 */
import Icon from "@/components/Icons.astro";
import { C, KMS_LOGO, KMS_PHONE_HREF } from "@/lib/brand";
---
<div class="bg-black" style="padding:0.65rem 0">
  <div class="max-w-7xl mx-auto px-3 sm:px-4">
    <div class="flex items-center gap-3 sm:gap-4 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-center">

      {/*
        Logo doubled from the original 48px to 96px per an earlier request.
        clamp() keeps that 96px as the true size from ~600px viewports up,
        but scales down on very narrow phones. lg:justify-self-start is
        belt-and-suspenders — default grid alignment already puts it at
        the cell's left edge, this just makes that explicit.
      */}
      <a href="/" aria-label="Kelsey Machine Services home" class="flex-shrink-0 lg:justify-self-start">
        <img src={KMS_LOGO} alt="Kelsey Machine Services" style="height:clamp(52px, 16vw, 96px);width:auto" />
      </a>

      {/* Button group — right of the logo on mobile/tablet (justify-end,
          capped at 50% of the remaining row width at sm+ via the inner
          wrapper's w-[50%]); on desktop this div is now a real grid cell
          matching the hero's right column, and lg:justify-center centers
          the button group within THAT column (not flex leftover space).
          Both buttons get the same min-height so the 2-line "Free Pickup
          / All 50 States" label doesn't make that button taller than
          "Call Now". */}
      <div class="flex-1 flex justify-end lg:flex-none lg:justify-center min-w-0">
        <div class="w-full sm:w-[50%] flex items-center gap-2 sm:gap-3 min-w-0">

        <a
          href={KMS_PHONE_HREF}
          class="flex-1 inline-flex items-center justify-center gap-1.5 sm:gap-2 text-white no-underline min-w-0"
          style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.04em;text-transform:uppercase;padding:0.6rem 0.7rem;border-radius:2px;line-height:1.15;min-height:3.4rem`}
          aria-label="Call Kelsey Machine Services now"
        >
          <Icon name="phone" size={18} />
          <span class="hidden sm:inline">Call Now</span>
        </a>

        <a
          href="#quote"
          class="flex-1 inline-flex items-center justify-center gap-1.5 sm:gap-2 text-white no-underline min-w-0"
          style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.04em;text-transform:uppercase;padding:0.6rem 0.7rem;border-radius:2px;line-height:1.15;text-align:center;min-height:3.4rem`}
          aria-label="Free pickup, all 50 states — jump to quote form"
        >
          <Icon name="truck" size={18} />
          <span class="hidden sm:inline">Free Pickup<br />All 50 States</span>
          <span class="sm:hidden">Pickup</span>
        </a>

      </div>
    </div>

    </div>
  </div>
</div>
