---
/**
 * Minimal PPC landing-page header — logo left, Call Now + Free Pickup
 * buttons grouped to the right. No nav links, no utility bar, no
 * Services dropdown.
 *
 * Landing pages exist to do ONE thing: get the visitor to fill out the
 * form (or call). Every nav link, dropdown, and secondary CTA in the
 * standard site Header.astro is a way for that visitor to leave before
 * converting. This strips all of that out but keeps two CTAs that point
 * BACK at the same conversion goal — Call Now (tel: link, converts by
 * phone instantly) and Free Pickup (scrolls to #quote).
 *
 * Layout: logo pinned left, then a button group to its right. The group
 * is capped at 50% of the remaining row width at sm+ (leaving a visible
 * gap between logo and buttons rather than the buttons running edge to
 * edge) and both buttons are equal width (flex:1) AND equal height —
 * forced via min-height, since "Free Pickup / All 50 States" wraps to two
 * lines while "Call Now" is one, which used to make them different
 * heights. On the smallest phones the group goes full-width instead of
 * 50% — at ~320px, two already-tight tap targets need the room.
 *
 * Used only where KmsLayout is given headerVariant="minimal" (currently
 * LpPage.astro, i.e. the 5 PPC landing pages). Header.astro is completely
 * untouched — this is a separate, additive component.
 */
import Icon from "@/components/Icons.astro";
import { C, KMS_LOGO, KMS_PHONE_HREF } from "@/lib/brand";
---
<div class="bg-black" style="padding:0.65rem 0">
  <div class="max-w-7xl mx-auto px-3 sm:px-4 flex items-center gap-3 sm:gap-4">

    {/*
      Logo doubled from the original 48px to 96px per an earlier request.
      clamp() keeps that 96px as the true size from ~600px viewports up,
      but scales down on very narrow phones.
    */}
    <a href="/" aria-label="Kelsey Machine Services home" class="flex-shrink-0">
      <img src={KMS_LOGO} alt="Kelsey Machine Services" style="height:clamp(52px, 16vw, 96px);width:auto" />
    </a>

    {/* Button group — right of the logo, capped at 50% of the remaining
        row width at sm+ via the inner wrapper's w-[50%] + the outer
        flex-1/justify-end pushing it to the row's right edge. Both
        buttons get the same min-height so the 2-line "Free Pickup / All
        50 States" label doesn't make that button taller than "Call Now". */}
    <div class="flex-1 flex justify-end min-w-0">
      <div class="w-full sm:w-[50%] flex items-center gap-2 sm:gap-3 min-w-0">

        <a
          href={KMS_PHONE_HREF}
          class="flex-1 inline-flex items-center justify-center gap-1.5 sm:gap-2 text-white no-underline min-w-0"
          style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.04em;text-transform:uppercase;padding:0.6rem 0.7rem;border-radius:2px;line-height:1.15;min-height:3.4rem`}
          aria-label="Call Kelsey Machine Services now"
        >
          <Icon name="phone" size={18} />
          <span class="hidden sm:inline">Call Now</span>
        </a>

        <a
          href="#quote"
          class="flex-1 inline-flex items-center justify-center gap-1.5 sm:gap-2 text-white no-underline min-w-0"
          style={`background:${C.green};font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1rem;letter-spacing:0.04em;text-transform:uppercase;padding:0.6rem 0.7rem;border-radius:2px;line-height:1.15;text-align:center;min-height:3.4rem`}
          aria-label="Free pickup, all 50 states — jump to quote form"
        >
          <Icon name="truck" size={18} />
          <span class="hidden sm:inline">Free Pickup<br />All 50 States</span>
          <span class="sm:hidden">Pickup</span>
        </a>

      </div>
    </div>

  </div>
</div>
